# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=booking_reviews
POSTGRES_PORT=5432

# Application Configuration
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/booking_reviews
APP_TIMEZONE=Australia/Sydney

# Scraper Security Gate
# Automated collection remains disabled unless authorized in writing
ALLOW_AUTOMATED_SCRAPING=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
BACKEND_API_URL=http://localhost:8000/api
